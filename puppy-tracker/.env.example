# Copy to .env for local dev. In production these are set in docker-compose.yml.

# Secret used to sign session cookies. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-change-me-please-0123456789abcdef

# Where the SQLite database file lives. Defaults to ./data/puppy.db.
DATABASE_PATH=./data/puppy.db

# Default PIN for the two seeded household users on first run (4+ digits).
# Change each user's PIN later in Settings.
SEED_PIN=1234

# Timezone used for "start of local day" calculations and display.
TZ=Europe/Brussels

# Required by adapter-node in production so form POSTs pass CSRF checks.
# Set to the URL you actually browse to, e.g. http://puppy.local:3000
# ORIGIN=http://puppy.local:3000
